# Neon Postgres connection string (use the pooled URL ending in -pooler)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/oddz?sslmode=require

# Random secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=replace-with-openssl-rand-hex-32

# Optional API keys. None of the four sources require auth for public reads,
# but Manifold and Kalshi raise rate limits when authenticated.
KALSHI_API_KEY=
MANIFOLD_API_KEY=
METACULUS_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- sweep
# None of this is needed for the monitor at /sweep or for the paper sampler —
# both read only public market data. It is only for the local control server.

# Create these at testnet.binancefuture.com (bottom of the trading page).
# They are used against demo-fapi.binance.com, which is a different host — see
# lib/sweep/exchange/binance.ts. No quotes, no spaces around the '='.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Demo trading unless this is exactly "1". Nothing else enables live orders,
# and a live key with this unset simply fails to authenticate — the safe way
# round for the mistake most likely to be made.
BINANCE_LIVE=

# Overrides the base URL entirely. Binance has moved the demo host once already.
BINANCE_BASE_URL=

# Fees. 0.9 once BNB fee payment is switched on; leave blank for no discount,
# which is the honest default — assuming a discount you have not enabled makes
# every proposal look cheaper than the trade really is.
SWEEP_FEE_DISCOUNT=
# Stop opening positions once fees pass this share of the day's gross profit.
SWEEP_MAX_FEE_SHARE=
# ...or this many dollars, whichever comes first. Blank disables it.
SWEEP_MAX_DAILY_FEE=
# An escalating fee schedule, if the account is on one.
# SWEEP_FEE_TIERS=[{"fromTradeCount":10,"makerRate":0.0004,"takerRate":0.0008}]

# Confirmed earnings dates. Without these the calendar runs on a projection
# from Intel's reporting pattern, which is good to about a week and therefore
# only derates size rather than blacking out.
# SWEEP_EVENTS=[{"label":"Intel Q3 2026","at":"2026-10-22T20:05:00Z","certainty":"confirmed"}]

# Control server. The token is generated and printed on first run if unset.
SWEEP_CONTROL_PORT=
SWEEP_CONTROL_TOKEN=

# --------------------------------------------------------------- whales
# Live holder tracker at /whales. It reads holders from chain state by
# replaying the token's Transfer logs, because no aggregator serves a holder
# list for an arbitrary chain: DexScreener has no holders endpoint, and GMGN's
# covers Solana, Ethereum, Base and BSC only. Those two are still used, but for
# price and liquidity, which is what they are actually authoritative for.
#
# REQUIRED. Comma-separated JSON-RPC endpoints for the chain the token is on,
# tried in order. Without this the page renders an explicit "not configured"
# state rather than an empty table.
HOLDERS_RPC_URLS=

# Defaults target RIPE and its RIPE/NVDA Uniswap-V2 pool on Robinhood Chain.
# Override to track any ERC-20 on any EVM chain; ?token= and ?pair= on the page
# override per request.
HOLDERS_TOKEN=
HOLDERS_PAIR=

# Leave unset and the tracker binary-searches for the token's deploy block, so
# the backfill does not start at genesis. Set it if your RPC prunes state and
# cannot answer historical eth_getCode.
HOLDERS_FROM_BLOCK=

# Blocks per eth_getLogs call. Halved automatically when an endpoint refuses a
# range, so this is a ceiling rather than a fixed size.
HOLDERS_LOG_CHUNK=2000

# Chain slugs for the price overlay.
HOLDERS_DEXSCREENER_CHAIN=robinhood
HOLDERS_GECKOTERMINAL_NETWORK=robinhood

HOLDERS_TOP_N=100
HOLDERS_MAX_FLOWS=200
