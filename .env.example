# Neon Postgres connection string (use the pooled URL ending in -pooler)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/oddz?sslmode=require

# Random secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=replace-with-openssl-rand-hex-32

# Optional API keys. None of the four sources require auth for public reads,
# but Manifold and Kalshi raise rate limits when authenticated.
KALSHI_API_KEY=
MANIFOLD_API_KEY=
METACULUS_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- INTC foundry monitor -----------------------------------------------
# Push channels for the foundry-catalyst monitor (/intc, /api/cron/intc).
# All optional and fired independently — set whichever you'll read on your
# phone. With none set, catalysts are still stored + logged, just not pushed.

# ntfy.sh — the zero-account path: pick a hard-to-guess topic, install the
# ntfy app, subscribe to the same topic. That's it.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Telegram — create a bot via @BotFather, then get your chat id (message the
# bot, then GET https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic JSON webhook — a Slack/Discord incoming webhook, a Zapier catch
# hook, or your own endpoint. Payload carries both `text` (Slack) and
# `content` (Discord) plus a structured `intc` object.
INTC_WEBHOOK_URL=

# Push only catalysts at or above this severity: low | medium | high | critical.
INTC_MIN_SEVERITY=high
