{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/api/sweep/binance/**/route.ts": {
      "regions": ["fra1"]
    }
  }
}
